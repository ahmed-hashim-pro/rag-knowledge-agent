# Copy to .env and fill in, or simply `export ANTHROPIC_API_KEY=...` in your shell.
# .env is gitignored and never read or written by the agent itself.
ANTHROPIC_API_KEY=your-key-here

# Optional overrides — every one of these has a sensible default.
# RAG_MODEL=claude-sonnet-4-6
# RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
# RAG_PERSIST_DIR=./chroma_db
# RAG_COLLECTION=knowledge
# RAG_CHUNK_TOKENS=500
# RAG_CHUNK_OVERLAP_TOKENS=50
# RAG_TOP_K=5
# RAG_MIN_SCORE=0.35
# RAG_MAX_CONTEXT_TOKENS=6000
# RAG_MAX_OUTPUT_TOKENS=1500
# RAG_HISTORY_TURNS=10
# RAG_MAX_HISTORY_TOKENS=12000
